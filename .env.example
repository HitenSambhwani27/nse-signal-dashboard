# Browser-facing API origin. Leave empty to use the Next.js same-origin
# rewrite proxy to FastAPI (avoids CORS). Set only if the backend allows
# the dashboard origin.
NEXT_PUBLIC_API_BASE_URL=

# Server-side rewrite target used by next.config.ts
API_BASE_URL=http://127.0.0.1:8080

# Python client (pytest / residual helpers)
NSE_API_URL=http://127.0.0.1:8080
