# Browser fetches same-origin `/api/v1/*` (Next.js route proxy).
# Leave empty so the browser and SharedWorker never talk to the VM directly.
NEXT_PUBLIC_API_BASE_URL=

# Server-side FastAPI origin used by Next.js /api/v1/* proxies.
# Application default when unset: http://127.0.0.1:8080 (local FastAPI).
# Port 18080 is NOT hardcoded in application code — set it here for a tunnel.

# Local FastAPI on this machine (isolated development, no SSH tunnel):
#   API_BASE_URL=http://127.0.0.1:8080

# VM tunnel (Windows localhost:18080 → VM 127.0.0.1:8080):
#   ssh -i "$env:USERPROFILE\.ssh\id_ed25519_do_nse" -L 18080:127.0.0.1:8080 nse@<vm-host>
API_BASE_URL=http://127.0.0.1:18080

# Legacy Streamlit / pytest client (optional). Same origin as API_BASE_URL.
# NSE_API_URL=http://127.0.0.1:8080
# NSE_API_URL=http://127.0.0.1:18080
